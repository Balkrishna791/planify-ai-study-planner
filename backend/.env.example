PLANIFY_SECRET_KEY=
GEMINI_API_KEY=
PLANIFY_CORS_ORIGINS=
PLANIFY_DB_PATH=
# Production PostgreSQL URL. Set this on the host; leave blank for free local SQLite.
# PLANIFY_DATABASE_URL takes precedence over the standard DATABASE_URL.
PLANIFY_DATABASE_URL=
PLANIFY_DEBUG=
# Set after deployment, e.g. https://planify.example.com. Used by sitemap/robots.
PLANIFY_PUBLIC_URL=
